{
  "name": "ghost-qa",
  "productName": "GhostQA",
  "version": "0.1.0",
  "description": "QA-ассистент: слушает вопросы по горячей клавише и мгновенно выдаёт ответы в оверлее поверх всех окон",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "rebuild": "electron-rebuild -f -w uiohook-napi",
    "dist": "electron-builder --win portable"
  },
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.ghostqa.app",
    "productName": "GhostQA",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "worker/**",
      "lib/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/prebuilds/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "GhostQA.exe"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "uiohook-napi": "^1.5.2"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "uiohook-napi@1.5.5": true,
    "protobufjs@6.11.6": true,
    "sharp@0.32.6": true
  }
}
