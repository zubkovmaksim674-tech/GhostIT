{
  "name": "ghostit",
  "productName": "GhostIT",
  "version": "0.2.6",
  "description": "GhostIT — IT-ассистент для собеседований: слушает вопросы (микрофон или звук звонка) и мгновенно выдаёт ответы ИИ в оверлее поверх всех окон",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "rebuild": "electron-rebuild -f -w uiohook-napi",
    "dist": "electron-builder --win portable nsis",
    "icons": "node scripts/make-icons.js",
    "lint": "eslint .",
    "test": "node --test test/unit.test.js",
    "release": "node scripts/release.js"
  },
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.ghostit.app",
    "productName": "GhostIT",
    "extraMetadata": {
      "version": "0.2.6"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "worker/**",
      "lib/**",
      "test/harness.js",
      "build/**",
      "!build/installer.nsh",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/prebuilds/**"
    ],
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "GhostIT.exe"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GhostIT",
      "artifactName": "GhostIT-Setup-${version}.exe",
      "uninstallDisplayName": "GhostIT"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "eslint": "^10.10.0"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "uiohook-napi": "^1.5.2"
  },
  "overrides": {
    "protobufjs": "^7.6.3",
    "sharp": "0.35.4"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "uiohook-napi@1.5.5": true,
    "protobufjs@7.6.6": true,
    "sharp@0.35.4": true
  }
}
